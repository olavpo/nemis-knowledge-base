---
layout: base.njk
---
{% set deviceLabel = "Mobile phone" if section == "mobile" else "Computer or laptop" %}
<div class="device-badge">{{ deviceLabel }}</div>
{#- Search results otherwise can't tell apart the phone and computer
   versions of the same guide (e.g. two results both reading "Enter
   classroom data"): six of the twelve guides share their title exactly
   with their other-device counterpart. Pagefind derives a result's title
   from the page's first <h1> unless data-pagefind-meta="title:..." is
   present, in which case the explicit value wins — so this overrides the
   indexed title to include the device, without changing what's visually
   on the page (the device already shows in the badge above). #}
<h1 class="page-title" data-pagefind-meta="title:{{ title }} · {{ deviceLabel }}">{{ title }}</h1>
<div class="page-desc">{{ content | safe }}</div>

{% if video %}
<hr class="divider">
{% include "video.njk" %}
{% if video.download %}
<div class="download-row">
  <span class="download-hint">Save for offline use?</span>
  <a class="download-btn" href="https://drive.google.com/uc?export=download&id={{ video.download }}" target="_blank" rel="noopener">&darr; Download video</a>
</div>
{% endif %}
{% endif %}

{% if jobaid %}
{% set pdf = jobaid | pdfMeta %}
<hr class="divider">
<div class="resource-block">
  <div class="resource-header">
    <span class="resource-header-label label-jobaid">Job aid</span>
    <span class="resource-header-meta">PDF &middot; {{ pdf.pages }} page{% if pdf.pages != 1 %}s{% endif %}</span>
  </div>
  <div class="pdf-container">
    <iframe src="{{ ('/assets/pdfs/' + jobaid) | url }}" title="{{ title }} — Job aid"></iframe>
  </div>
</div>
<div class="download-row">
  <span class="download-hint">{{ title }} &middot; PDF &middot; {{ pdf.size }}</span>
  <a class="download-btn" href="{{ ('/assets/pdfs/' + jobaid) | url }}" download>&darr; Download</a>
</div>
{% endif %}

{% if next and next.length %}
<hr class="divider">
<div class="next-label">Do this next</div>
<div class="next-list">
  {% for slug in next %}
    {% set guide = slug | guideBySlug %}
    {% if guide %}{% include "card.njk" %}{% endif %}
  {% endfor %}
</div>
{% endif %}
