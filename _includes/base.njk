<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.title %}{{ site.title }} - {{ title }}{% else %}{{ site.title }}{% endif %}</title>
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
<link rel="stylesheet" href="{{ '/pagefind/pagefind-ui.css' | url }}">
</head>
<body>

<header class="site-header" data-pagefind-ignore>
  <a class="site-brand" href="{{ '/' | url }}">
    <img class="site-logo" src="{{ site.logo | url }}" alt="{{ site.logoAlt }}">
    <span class="site-title">{{ site.title }}</span>
  </a>
  <nav class="site-nav">
    {% for item in site.nav %}
    <a href="{{ item.url | url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.text }}</a>
    {% endfor %}
  </nav>
  <div id="search" class="site-search"></div>
</header>

{% if hero %}
<div class="hero">
  <h1 class="hero-title">{%- if hero.icon %}<svg class="section-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
      </svg>{% endif -%}{{ hero.title or site.hero.title }}</h1>
  <p class="hero-subtitle">{{ hero.subtitle or site.hero.subtitle }}</p>
</div>
{% endif %}

<main class="site-main" data-pagefind-body>
{{ content | safe }}
</main>

<footer class="site-footer" data-pagefind-ignore>{{ site.footer }}</footer>

<script src="{{ '/pagefind/pagefind-ui.js' | url }}"></script>
<script>
  window.addEventListener("DOMContentLoaded", () => {
    new PagefindUI({ element: "#search", showSubResults: true, showImages: false });
  });
</script>

</body>
</html>
